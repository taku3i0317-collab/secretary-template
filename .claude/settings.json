{
  "env": {
    "CLAUDE_CODE_MAX_SUBAGENT_SPAWN_DEPTH": "1",
    "CLAUDE_CODE_FORK_SUBAGENT": "0",
    "CLAUDE_CODE_USE_POWERSHELL_TOOL": "0"
  },
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push origin main)",
      "Bash(git push)",
      "Bash(git pull --rebase:*)",
      "Bash(git mv:*)",
      "Bash(claude --version)",
      "Edit(/status/**)",
      "Write(/status/**)",
      "Edit(/knowledge/**)",
      "Write(/knowledge/**)",
      "Edit(/roles/**)",
      "Write(/roles/**)",
      "Edit(/org/**)",
      "Write(/org/**)",
      "Edit(/journal/**)",
      "Write(/journal/**)",
      "Edit(/inbox/**)",
      "Write(/inbox/**)"
    ],
    "ask": [
      "Edit(/CLAUDE.md)",
      "Write(/CLAUDE.md)",
      "Edit(/.claude/skills/**)",
      "Write(/.claude/skills/**)"
    ],
    "deny": [
      "Bash(git checkout --:*)",
      "Bash(git restore:*)",
      "Bash(git stash drop:*)",
      "Bash(git reset --hard:*)",
      "Bash(git clean:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git commit --amend:*)",
      "Bash(git rebase:*)",
      "Bash(git branch -D:*)",
      "Bash(git worktree remove:*)",
      "Bash(git -C:*)",
      "Bash(cd:*)",
      "Bash(rm:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Edit(/.claude/settings.json)",
      "Write(/.claude/settings.json)",
      "Edit(/.claude/agents/**)",
      "Write(/.claude/agents/**)",
      "Edit(/.claude/scripts/**)",
      "Write(/.claude/scripts/**)",
      "Agent(Explore)",
      "Agent(Plan)",
      "Agent(general-purpose)",
      "Agent(claude)",
      "Agent(fork)"
    ]
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/scripts/session-start.ps1\""
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NoProfile -ExecutionPolicy Bypass -File \"$CLAUDE_PROJECT_DIR/.claude/scripts/life-log.ps1\""
          }
        ]
      }
    ]
  }
}
